# Never commit .env.local.

# Default development mode. No network geocoding request is sent.
VITE_GEOCODING_PROVIDER=mock

# To use a production-capable Nominatim-compatible service, set both values below.
# Do not hardcode the public OSMF instance as the production default.
# VITE_GEOCODING_PROVIDER=nominatim
# VITE_NOMINATIM_BASE_URL=https://your-nominatim-compatible-service.example/

# Google Maps JavaScript API / Routes API / Maps Static API. Restrict this key by HTTP referrer.
# VITE_GOOGLE_MAPS_API_KEY=

# Use Google's interactive map together with Google route results.
# VITE_MAP_PROVIDER=google

# Default route mode. Uses a straight line and sends no network request.
VITE_ROUTING_PROVIDER=straight

# Google mode uses the Maps JavaScript API Route class and returns per-leg times.
# VITE_ROUTING_PROVIDER=google

# To use an OSRM-compatible service, configure its root endpoint and profile names.
# VITE_ROUTING_PROVIDER=osrm
# VITE_ROUTING_API_BASE_URL=https://your-osrm-compatible-service.example/
# VITE_OSRM_WALKING_PROFILE=walking
# VITE_OSRM_DRIVING_PROFILE=driving
